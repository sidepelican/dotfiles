// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    "context": "Workspace",
    "bindings": {
      // "shift shift": "file_finder::Toggle"
    },
  },
  {
    "context": "Editor && vim_mode == insert",
    "bindings": {
      // "j k": "vim::NormalBefore"
    },
  },
  {
    "context": "Editor",
    "bindings": {
      "cmd-shift-o": "file_finder::Toggle"
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "ctrl-6": "outline::Toggle"
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "cmd-shift-d": [
        "editor::SelectPrevious",
        {
          "replace_newest": false
        }
      ]
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "alt-cmd-[": "editor::MoveLineUp"
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "alt-cmd-]": "editor::MoveLineDown"
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "ctrl-shift-down": [
        "editor::AddSelectionBelow",
        {
          "skip_soft_wrap": true
        }
      ]
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "ctrl-shift-up": [
        "editor::AddSelectionAbove",
        {
          "skip_soft_wrap": true
        }
      ]
    }
  },
  {
    "context": "Editor && mode == full",
    "unbind": {
      "cmd-shift-o": "outline::Toggle"
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "ctrl-cmd-j": "editor::GoToDefinition"
    }
  },
  {
    "context": "Editor",
    "unbind": {
      "f12": "editor::GoToDefinition"
    }
  },
  {
    "context": "Pane",
    "bindings": {
      "ctrl-cmd-left": "pane::GoBack"
    }
  },
  {
    "context": "Pane",
    "unbind": {
      "ctrl--": "pane::GoBack"
    }
  },
  {
    "context": "ThreadHistory",
    "bindings": {
      "ctrl-cmd-left": "pane::GoBack"
    }
  },
  {
    "context": "ThreadHistory",
    "unbind": {
      "ctrl--": "pane::GoBack"
    }
  },
  {
    "context": "AcpThread",
    "bindings": {
      "ctrl-cmd-left": "pane::GoBack"
    }
  },
  {
    "context": "AcpThread",
    "unbind": {
      "ctrl--": "pane::GoBack"
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "ctrl-cmd-left": "pane::GoBack"
    }
  },
  {
    "context": "Pane",
    "bindings": {
      "ctrl-cmd-right": "pane::GoForward"
    }
  },
  {
    "context": "Pane",
    "unbind": {
      "ctrl-_": "pane::GoForward"
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "ctrl-cmd-right": "pane::GoForward"
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "ctrl-cmd-e": "editor::Rename"
    }
  },
  {
    "context": "Editor",
    "unbind": {
      "f2": "editor::Rename"
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "ctrl-i": "editor::Format"
    }
  },
  {
    "context": "Editor",
    "unbind": {
      "cmd-shift-i": "editor::Format"
    }
  },
  {
    "context": "Editor && mode == full",
    "bindings": {
      "ctrl-i": "editor::FormatSelections"
    }
  },
  {
    "context": "ProjectPanel && not_editing",
    "bindings": {
      "enter": "project_panel::Open"
    }
  },
  {
    "context": "ProjectPanel && not_editing",
    "unbind": {
      "space": "project_panel::Open"
    }
  },
  {
    "context": "ProjectPanel",
    "bindings": {
      "ctrl-cmd-e": "project_panel::Rename"
    }
  },
  {
    "context": "ProjectPanel",
    "unbind": {
      "f2": "project_panel::Rename"
    }
  },
  {
    "bindings": {
      "cmd-1": "project_panel::Toggle"
    }
  },
  {
    "context": "!AcpThread > Editor && mode == full",
    "bindings": {
      "cmd-shift-j": "pane::RevealInProjectPanel"
    }
  },
  {
    "context": "!AcpThread > Editor && mode == full",
    "unbind": {
      "cmd-shift-e": "pane::RevealInProjectPanel"
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "cmd-j": "editor::ToggleFocus"
    }
  }
]
